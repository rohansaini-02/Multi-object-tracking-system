# ==============================================================================
# Multi-Object Tracking System - Environment Configuration Template
# Copy this file to '.env' and update the values for your environment.
# ==============================================================================

# Application & API Settings
PROJECT_NAME="Multi-Object Tracking System API"
API_V1_STR="/api/v1"
SECRET_KEY="dev-secret-key-change-in-production-123456789"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database & Redis Settings
# Defaults to PostgreSQL with asyncpg driver; falls back to SQLite if unreachable
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/multi_object_tracking_db"
REDIS_URL="redis://localhost:6379/0"

# Storage Directories
UPLOAD_DIR="data/uploads"
OUTPUT_DIR="data/outputs"
RESULTS_DIR="data/results"
MOT17_DIR="data/mot17"
WEIGHTS_DIR="weights"

# Neural Network Model Weights
YOLO_MODEL_PATH="weights/yolov8m.pt"
REID_BASE_WEIGHTS_PATH="weights/reid_base.pth"
REID_FINETUNED_WEIGHTS_PATH="weights/reid_fine_tuned.pth"

# Google OAuth 2.0 Credentials (Optional - leave empty for local auth only)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

