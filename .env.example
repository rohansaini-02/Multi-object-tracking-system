# Security
SECRET_KEY=change_this_to_a_secure_random_32_byte_string

# Postgres Configuration
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/mot_db

# Redis Configuration
REDIS_URL=redis://redis:6379/0

# Hardware & Model Weights
DEVICE=cuda
YOLO_MODEL_PATH=weights/yolov8n.pt
REID_BASE_WEIGHTS_PATH=weights/ckpt.t7
REID_FINETUNED_WEIGHTS_PATH=weights/reid_finetuned.pth

# Defaults
DEFAULT_CONFIDENCE_THRESHOLD=0.5
DEFAULT_MAX_COASTING_AGE=30
